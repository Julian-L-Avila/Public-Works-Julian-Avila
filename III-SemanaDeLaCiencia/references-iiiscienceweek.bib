@article{cogliatiRemarksHistoryRiccis2024,
  title = {Some Remarks on the History of {{Ricci}}'s Absolute Differential Calculus},
  author = {Cogliati, Alberto},
  date = {2024-11},
  journaltitle = {Archive for History of Exact Sciences},
  shortjournal = {Arch. Hist. Exact Sci.},
  volume = {78},
